# Runtime environment (optional)
# "production" enables the production startup checks: a weak JWT_SECRET or a
# localhost origin in CORS_ORIGINS aborts the boot before listening.
# Any other value (or none) runs the server as development.
NODE_ENV="development"

# Database connection string (REQUIRED)
# PostgreSQL is the active provider (see prisma/schema.prisma).
# En local se usa el PostgreSQL que ya tengas corriendo; en Render/Neon se
# copia la cadena del panel de Neon (incluye sslmode=require).
DATABASE_URL="postgresql://postgres:123456@localhost:5432/workflow_db?schema=public"

# Direct (unpooled) connection string for the Prisma CLI (optional)
# `prisma migrate deploy` takes a session-level advisory lock, which does not
# survive the transaction boundary of a transaction-mode pooler. Neon's
# `-pooler` host is PgBouncer in that mode, so migrating through it fails
# intermittently with P1002 ("Timed out trying to acquire a postgres advisory
# lock"). Point this at the *unpooled* host (the same string without `-pooler`):
# the CLI migrates through it while the app keeps using the pooled DATABASE_URL.
# En local, sin pooler, puede omitirse: el CLI usa DATABASE_URL como respaldo.
# DIRECT_URL="postgresql://usuario:clave@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# JWT Configuration (REQUIRED - server will not start without this)
# Placeholder: production startup rejects this value and any secret shorter
# than 32 characters.
JWT_SECRET="your-super-secret-key-change-in-production"

# CORS Configuration (comma-separated origins)
# Production startup rejects any localhost/127.0.0.1 entry.
# Al desplegar con un solo origen (el SPA y el API en el mismo servicio) se
# pone la URL pública de ese servicio, p. ej.
# CORS_ORIGINS="https://workflows.onrender.com". Además de CORS, esta lista es
# la que usa la protección CSRF para validar el Origin/Referer.
CORS_ORIGINS="http://localhost:3000"

# Server Port
PORT=5000
API_PORT=5000

# Frontend build/runtime configuration
# Origen del API cuando frontend y API se despliegan en distintos orígenes.
# En desarrollo sin proxy entre distintos puertos, se puede fijar a http://localhost:5000.
# En el despliegue de un solo origen (Dockerfile + render.yaml) se deja VACÍO
# a propósito: el SPA usa rutas relativas /api contra el mismo servidor.
PUBLIC_API_URL=""

# Document storage backend (optional; default "disk")
# Where the bytes of an uploaded document are persisted:
#   disk     -> the directory in UPLOADS_DIR. Development, and any deployment
#               with a persistent volume mounted there.
#   postgres -> inside the database. Use it on platforms with an ephemeral
#               filesystem (the free plan of Render, for instance): nothing is
#               written to the container, so documents survive a redeploy.
# Each stored file records the backend it was saved with, so changing this
# value never makes already stored documents unreachable.
STORAGE_BACKEND="disk"

# Upload directory (only read by the "disk" storage backend)
# On a deployment with an ephemeral disk, prefer STORAGE_BACKEND="postgres".
UPLOADS_DIR="uploads"

# Disables the API rate limiters (used by the E2E suite, which creates many
# sessions). Only set it to "true" in trusted environments.
DISABLE_RATE_LIMIT="false"

# API rate limit (optional). Maximum number of requests per window and the
# window length in milliseconds, applied to every /api endpoint except the
# read-only polling endpoints (notifications and chat messages). Missing or
# non-positive-integer values fall back to the defaults shown here.
API_RATE_LIMIT_MAX="1000"
API_RATE_LIMIT_WINDOW_MS="900000"
